new file mode 100644
index 0000000..54ce1c2
--- /dev/null
+++ b/tools/package_customer_release.py
@@ -0,0 +1,131 @@
+"""Package an already built frozen runtime and a small editable customer kit.
+
+The output is a candidate until tools/verify_customer_release.py passes. No tag,
+GitHub Release or deployment is changed by this tool.
+"""
+import argparse
+import gzip
+import hashlib
+import importlib.metadata as metadata
+import json
+from pathlib import Path
+import platform
+import shutil
+import subprocess
+import tarfile
+
+ROOT = Path(__file__).resolve().parents[1]
+RUNTIME_NAME = 'OmindOS-Manipulation-0.2-runtime-linux-amd64.tar.gz'
+CLIENT_NAME = 'OmindOS-Manipulation-0.2-client.tar.gz'
+
+
+def sha(path):
+    with path.open('rb') as f:
+        return hashlib.file_digest(f, 'sha256').hexdigest()
+
+
+def archive(source, path):
+    with tarfile.open(path, 'w:gz', compresslevel=6) as out:
+        out.add(source, arcname=source.name)
+
+
+def audit(runtime):
+    core = ('community', 'motion', 'modeling', 'robot_sim', 'basis', 'visualization')
+    leaked = [str(p.relative_to(runtime)) for p in runtime.rglob('*')
+              if p.is_file() and p.suffix in ('.py', '.pyx', '.c', '.cpp')
+              and any(part in core for part in p.relative_to(runtime).parts)]
+    if leaked:
+        raise RuntimeError('Core plaintext source in runtime: ' + ', '.join(leaked[:10]))
+    if list(runtime.rglob('.git')):
+        raise RuntimeError('Git history must not enter the runtime')
+    return dict(status='passed', core_plaintext_files=0,
+                packaging='PyInstaller frozen Python bytecode and shared libraries; not encryption',
+                runtime_files=sum(p.is_file() for p in runtime.rglob('*')))
+
+
+def main():
+    cli = argparse.ArgumentParser(description=__doc__)
+    cli.add_argument('--runtime', type=Path, required=True)
+    cli.add_argument('--output', type=Path, required=True)
+    args = cli.parse_args()
+    if platform.system() != 'Linux' or platform.machine() != 'x86_64':
+        raise SystemExit('This candidate is Linux x86_64 only')
+    runtime_input = args.runtime.resolve(strict=True)
+    if not (runtime_input/'omindos-runtime').is_file():
+        raise SystemExit('Missing frozen omindos-runtime executable')
+    output = args.output.resolve()
+    output.mkdir(parents=True, exist_ok=False)
+    runtime = output/'staging/runtime'
+    shutil.copytree(runtime_input, runtime)
+    licenses = runtime/'licenses'
+    licenses.mkdir()
+    shutil.copy2(ROOT/'LICENSE', licenses/'WRS-MIT.txt')
+    shutil.copy2(ROOT/'ATTRIBUTION.md', licenses/'ATTRIBUTION.md')
+    inventory = []
+    for dist in metadata.distributions():
+        name = dist.metadata.get('Name', 'unknown')
+        files = [p for p in (dist.files or []) if any(
+            x.lower().startswith(('license', 'copying', 'notice', 'copyright')) for x in p.parts)]
+        inventory.append(dict(name=name, version=dist.version,
+                              license_metadata=dist.metadata.get('License'),
+                              license_files=[str(p) for p in files]))
+        for path in files:
+            source = Path(dist.locate_file(path))
+            if source.is_file():
+                destination = licenses/'dependencies'/name/str(path)
+                destination.parent.mkdir(parents=True, exist_ok=True)
+                shutil.copy2(source, destination)
+    (licenses/'build-environment.json').write_text(json.dumps(inventory, indent=2)+'\n')
+    # These are build inputs, not a claim that every listed distribution is used
+    # by the executable. PyInstaller's own TOC is retained in developer evidence.
+    audit_result = audit(runtime)
+    client = output/'staging/OmindOS-Manipulation-0.2'
+    (client/'sdk').mkdir(parents=True)
+    for path in ('__init__.py', 'omindos_client.py'):
+        shutil.copy2(ROOT/'sdk'/path, client/'sdk'/path)
+    (client/'examples').mkdir()
+    shutil.copy2(ROOT/'examples/customer/mobile_dual_api.py', client/'examples/mobile_dual_api.py')
+    shutil.copytree(ROOT/'community/models/realman_rm75', client/'robot/arm-model')
+    # Uncompressed mesh copies make the provided manufacturer URDF usable by
+    # ordinary external URDF viewers as well as the frozen runtime.
+    for path in (client/'robot/arm-model/meshes').glob('*.gz'):
+        path.with_suffix('').write_bytes(gzip.decompress(path.read_bytes()))
+        path.unlink()
+    arms = json.loads((ROOT/'configs/simulation/dual-rm75.reference.json').read_text())
+    for side in ('left', 'right'):
+        arms[side]['urdf_path'] = 'arm-model/RM75-B.urdf'
+    (client/'robot/arms.json').write_text(json.dumps(arms, indent=2)+'\n')
+    shutil.copy2(ROOT/'configs/simulation/rm75-waist.reference.json', client/'robot/waist.json')
+    shutil.copy2(ROOT/'configs/simulation/rm75-navigation.reference.json', client/'robot/navigation.json')
+    shutil.copy2(ROOT/'docs/CUSTOMER_RELEASE.zh-CN.md', client/'README.md')
+    shutil.copy2(ROOT/'LICENSE', client/'LICENSE')
+    shutil.copy2(ROOT/'ATTRIBUTION.md', client/'ATTRIBUTION.md')
+    revision = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip()
+    dirty = bool(subprocess.check_output(['git', 'status', '--porcelain'], cwd=ROOT, text=True).strip())
+    manifest = dict(product='OmindOS Manipulation', version='0.2', package_revision='runtime.1',
+                    base_commit=revision, uncommitted_changes=dirty, simulation_only=True,
+                    platform=platform.platform(), machine=platform.machine(), source_audit=audit_result)
+    (client/'VERSION.json').write_text(json.dumps(manifest, indent=2)+'\n')
+    (output/'manifest.json').write_text(json.dumps(manifest, indent=2)+'\n')
+    archive(runtime, output/RUNTIME_NAME)
+    runtime_hash = sha(output/RUNTIME_NAME)
+    install = '''#!/bin/sh
+set -eu
+cd "$(dirname "$0")"
+test "$(uname -s)" = Linux && test "$(uname -m)" = x86_64 || { echo 'Linux x86_64 required'; exit 1; }
+command -v python3 >/dev/null
+test ! -e runtime || { echo 'runtime already exists; use a fresh release directory'; exit 1; }
+printf '%s  %s\\n' 'RUNTIME_HASH' '../RUNTIME_NAME' | sha256sum -c -
+tar -xzf ../RUNTIME_NAME
+./runtime/omindos-runtime --version
+echo 'Installed. Run: python3 examples/mobile_dual_api.py'
+'''.replace('RUNTIME_HASH', runtime_hash).replace('RUNTIME_NAME', RUNTIME_NAME)
+    (client/'install.sh').write_text(install)
+    (client/'install.sh').chmod(0o755)
+    archive(client, output/CLIENT_NAME)
+    (output/'SHA256SUMS').write_text(''.join(f'{sha(output/name)}  {name}\n' for name in (CLIENT_NAME, RUNTIME_NAME)))
+    print(json.dumps(dict(output=str(output), files=[CLIENT_NAME, RUNTIME_NAME, 'SHA256SUMS'], audit=audit_result)))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/runtime.spec b/tools/runtime.spec
new file mode 100644
index 0000000..b8c5803
--- /dev/null
+++ b/tools/runtime.spec
@@ -0,0 +1,25 @@
+# Build from the repository root with Python 3.12 / PyInstaller 6.11.1.
+from pathlib import Path
+from PyInstaller.utils.hooks import collect_data_files, collect_dynamic_libs
+
+root = Path(SPECPATH).parent
+demo_names = ('quick_start', 'ur3e_single_arm', 'grasping', 'motion_planning',
+              'dual_arm', 'mobile_dual_arm', 'integrated_task', 'mobile_dual_pitch', 'rm75_navigation')
+datas = [(str(root / 'configs/simulation'), 'configs/simulation'),
+         (str(root / 'community/models'), 'community/models')]
+datas += collect_data_files('robot_sim', includes=['**/*.stl', '**/*.STL', '**/*.dae', '**/*.obj'])
+datas += collect_data_files('basis.trimesh', includes=['**/*.json', '**/*.template'])
+binaries = collect_dynamic_libs('panda3d')
+a = Analysis([str(root / 'community/runtime_entry.py')], pathex=[str(root)],
+             binaries=binaries, datas=datas,
+             hiddenimports=['community.api_worker'] + ['community.' + name for name in demo_names],
+             hookspath=[], hooksconfig={}, runtime_hooks=[],
+             excludes=['torch', 'tensorflow', 'IPython', 'jupyter', 'pytest', 'notebook',
+                       'open3d.cuda', 'open3d.visualization.tensorboard_plugin'],
+             noarchive=False)
+# This release uses CPU geometric planning only; do not ship the unused CUDA runtime.
+a.binaries = [entry for entry in a.binaries if not entry[0].startswith('open3d/cuda/')]
+pyz = PYZ(a.pure)
+exe = EXE(pyz, a.scripts, [], exclude_binaries=True, name='omindos-runtime',
+          debug=False, bootloader_ignore_signals=False, strip=False, upx=False, console=True)
+coll = COLLECT(exe, a.binaries, a.datas, strip=False, upx=False, name='omindos-runtime')
diff --git a/tools/verify_customer_release.py b/tools/verify_customer_release.py
new file mode 100644
index 0000000..b54b720
--- /dev/null
+++ b/tools/verify_customer_release.py
@@ -0,0 +1,115 @@
+"""Verify the actual extracted customer kit with a system Python and frozen core."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tarfile
+import tempfile
+import time
+
+ROOT = Path(__file__).resolve().parents[1]
+RUNTIME = 'OmindOS-Manipulation-0.2-runtime-linux-amd64.tar.gz'
+CLIENT = 'OmindOS-Manipulation-0.2-client.tar.gz'
+
+CHECK = '''import copy,json,xml.etree.ElementTree as ET
+from pathlib import Path
+from sdk.omindos_client import ManipulationClient
+
+def finish(client, task, expected="succeeded"):
+    result=client.wait(task,timeout=120)
+    assert result["status"] == expected, result
+    return result["result"]
+
+arms=Path("robot/arms.json")
+waist=Path("robot/waist.json")
+with ManipulationClient() as client:
+    info=finish(client,client.get_mobile_model(arm_config=arms,waist_config=waist))
+    assert info["dof"] == 15
+    start=info["home_positions_rad"]
+    goal=start.copy();goal[0],goal[7],goal[14]=.1,.2,-.2
+    path=finish(client,client.plan_mobile_joint_motion(start,goal,arm_config=arms,waist_config=waist))
+    assert path["positions_rad"][0] == start and path["positions_rad"][-1] == goal
+    finish(client,client.plan_mobile_joint_motion(start,goal,obstacles=[
+        {"size_m":[3,3,3],"position_m":[0,0,1]}],arm_config=arms,waist_config=waist),"failed")
+    tree=ET.parse("robot/arm-model/RM75-B.urdf")
+    tree.find("joint[@name='joint_1']/limit").set("upper","1.60")
+    changed=Path("robot/arm-model/changed.urdf");tree.write(changed)
+    config=json.loads(arms.read_text());config["left"]["urdf_path"]="arm-model/changed.urdf"
+    config["left"]["model"]="URDF-7R"
+    changed_config=Path("robot/changed-arms.json");changed_config.write_text(json.dumps(config))
+    info=finish(client,client.get_mobile_model(arm_config=changed_config,waist_config=waist))
+    assert info["limits_rad"][1][1] == 1.60
+    goal[1]=1.7
+    finish(client,client.plan_mobile_joint_motion(start,goal,arm_config=changed_config,waist_config=waist),"failed")
+    task=client.run_demo("integrated_task")
+    assert client.stop(task)["status"] == "canceled"
+    assert client.get_status(task)["status"] == "canceled"
+    task=client.run_demo("integrated_task")
+    result=client.wait(task,timeout=.000001)
+    assert result["status"] == "failed" and result["error"]["code"] == "timeout"
+    trace=json.loads(Path("results/customer-api.json").read_text())["mobile_task"]["result"]["navigation"]
+    trace["samples"][-1]["twist"][0]=.1
+    finish(client,client.plan_mobile_task(navigation_trace=trace),"failed")
+print(json.dumps({"status":"passed","checks":["requested-15-joint-endpoints","collision-failure",
+    "external-URDF-limits","URDF-out-of-range-failure","cancel","timeout","stop-gate-failure"]}))
+'''
+
+
+def main():
+    cli = argparse.ArgumentParser(description=__doc__)
+    cli.add_argument('--candidate', type=Path, required=True)
+    cli.add_argument('--python', default='/usr/bin/python3')
+    args = cli.parse_args()
+    candidate = args.candidate.resolve(strict=True)
+    for line in (candidate/'SHA256SUMS').read_text().splitlines():
+        digest, name = line.split()
+        if name not in (RUNTIME, CLIENT):
+            raise RuntimeError('Unexpected asset in checksums')
+        with (candidate/name).open('rb') as f:
+            if hashlib.file_digest(f, 'sha256').hexdigest() != digest:
+                raise RuntimeError('Asset checksum mismatch: '+name)
+    env = {k:v for k,v in os.environ.items() if k not in
+           ('PYTHONPATH', 'PYTHONHOME', 'OMINDOS_MANIPULATION_RUNTIME')}
+    started = time.monotonic()
+    results = []
+    with tempfile.TemporaryDirectory(prefix='omindos-customer-acceptance-') as temp:
+        destination = Path(temp)
+        with tarfile.open(candidate/CLIENT) as bundle:
+            bundle.extractall(destination, filter='data')
+        with tarfile.open(candidate/RUNTIME) as bundle:
+            bundle.extractall(destination/'OmindOS-Manipulation-0.2', filter='data')
+        customer = destination/'OmindOS-Manipulation-0.2'
+        # Source is not available from the SDK's working directory. No checkout
+        # path is put in sys.path or passed to the algorithm process.
+        if (customer/'community').exists():
+            raise RuntimeError('Development directory leaked into customer kit')
+        for name, command in [('example', [args.python, 'examples/mobile_dual_api.py']),
+                              ('negative-and-config-checks', [args.python, '-c', CHECK])]:
+            run = subprocess.run(command, cwd=customer, env=env, capture_output=True, text=True, timeout=240)
+            (candidate/(name+'.log')).write_text(run.stdout+run.stderr)
+            if run.returncode:
+                raise RuntimeError(f'{name}: exit={run.returncode}; see {candidate/name}.log')
+            results.append(dict(name=name, status='passed'))
+        core = ('community', 'motion', 'basis', 'modeling', 'robot_sim', 'visualization')
+        sources = [str(p.relative_to(customer/'runtime')) for p in (customer/'runtime').rglob('*.py')
+                   if any(x in core for x in p.relative_to(customer/'runtime').parts)]
+        if sources:
+            raise RuntimeError('Plaintext core sources found: '+str(sources[:10]))
+        report = json.loads((customer/'results/customer-api.json').read_text())
+        plan = report['mobile_task']['result']
+        summary = dict(status='passed', version='0.2', package_revision='runtime.1',
+                       independent_source_directory=True, client_python=args.python,
+                       validation_platform=__import__('platform').platform(),
+                       checks=results, core_plaintext_files=0, dof=15,
+                       base_final_pose=plan['navigation']['samples'][-1]['pose'],
+                       phase_history=plan['phase_history'],
+                       elapsed_s=round(time.monotonic()-started, 2), hardware='not tested')
+    (candidate/'VALIDATION.json').write_text(json.dumps(summary, indent=2)+'\n')
+    print(json.dumps(summary))
+
+
+if __name__ == '__main__':
+    main()
