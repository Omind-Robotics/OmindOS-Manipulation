diff --git a/.github/workflows/customer-runtime.yml b/.github/workflows/customer-runtime.yml
new file mode 100644
index 0000000..1da687e
--- /dev/null
+++ b/.github/workflows/customer-runtime.yml
@@ -0,0 +1,34 @@
+name: Customer runtime package
+on:
+  pull_request:
+  push:
+    branches: [main]
+  workflow_dispatch:
+permissions:
+  contents: read
+jobs:
+  customer-package:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 20
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+          cache: pip
+          cache-dependency-path: requirements-community.txt
+      - run: python -m pip install -r requirements-community.txt pyinstaller==6.11.1
+      - run: python -m PyInstaller --noconfirm tools/runtime.spec
+      - run: python tools/package_customer_release.py --runtime dist/omindos-runtime --output build/customer-candidate
+      - run: python tools/verify_customer_release.py --candidate build/customer-candidate
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: manipulation-0.2-customer-runtime-linux-amd64
+          compression-level: 0
+          path: |
+            build/customer-candidate/*.tar.gz
+            build/customer-candidate/SHA256SUMS
+            build/customer-candidate/manifest.json
+            build/customer-candidate/VALIDATION.json
+            build/customer-candidate/*.log
